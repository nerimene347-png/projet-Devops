# --- Serveur ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Base de données MongoDB ---
MONGODB_URI=mongodb://localhost:27017/onetech_bs_sensibilisation

# --- JWT (émis par l'API après validation de l'identité via Active Directory) ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# --- Active Directory / LDAP ---
# URL du contrôleur de domaine, ex: ldap://192.168.1.10:389 ou ldaps://ad.onetechbs.com:636
LDAP_URL=ldap://ad.onetechbs.local:389
# Compte de service utilisé pour rechercher les utilisateurs dans l'annuaire (lecture seule)
LDAP_BIND_DN=CN=svc-sensibilisation,OU=ServiceAccounts,DC=onetechbs,DC=local
LDAP_BIND_PASSWORD=change_me
# Base de recherche des comptes utilisateurs
LDAP_BASE_DN=OU=Utilisateurs,DC=onetechbs,DC=local
# Suffixe UPN utilisé pour le bind de l'utilisateur qui se connecte (username@DOMAINE)
LDAP_DOMAIN_SUFFIX=onetechbs.local

# Comptes (sAMAccountName) à considérer comme Administrateur de la plateforme
# lors de leur toute première connexion. Séparés par des virgules.
BOOTSTRAP_ADMIN_USERNAMES=youssef.mejri

# --- Signataires des attestations (peuvent aussi être gérés en base plus tard) ---
SIGNATAIRE_DRH_NOM="Amira Nasri"
SIGNATAIRE_DG_NOM="Ahmed Slim"